{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magicshow",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-08-07",
  // Static site in ./src/client, plus an /api/* relay so the Google API
  // keys stay server-side. Assets are matched first; anything that isn't
  // a file falls through to the Worker.
  "assets": {
    "directory": "./src/client",
    "binding": "ASSETS"
  },
  // Non-secret settings. The API keys are secrets — see the README.
  "vars": {
    "CALENDAR_ID": "chenhenrybunny@gmail.com",
    "CALENDAR_TIME_ZONE": "America/Los_Angeles",
    "YOUTUBE_PLAYLIST_ID": "PLKcHew3eLgPd94aYmo-0KwZ8wSR3HJ_RC",
    "YOUTUBE_MAX_RESULTS": "50",
    // Sent as the Referer on Google calls so referrer-restricted keys still
    // work now that requests come from the Worker instead of the browser.
    "API_REFERRER": "https://magician.chen-henry.org/",
    // Whether Google emails the guest when /api/register adds them:
    // "all" sends the invitation, "none" adds them silently.
    "CALENDAR_SEND_UPDATES": "all",
    // OAuth 2.0 Client ID for "Sign in with Google" (top-right of the nav).
    // Reuses the same Client ID as GOOGLE_OAUTH_CLIENT_ID (the secret below)
    // — one fewer credential to manage. Not a secret itself (client IDs are
    // public), but the Worker checks it as the `aud` on every ID token. Same
    // value also goes in src/client/js/config.js — see README. Requires
    // this site's origin added under "Authorized JavaScript origins" on
    // that Client ID in Google Cloud Console.
    "GOOGLE_SIGNIN_CLIENT_ID": "600675471306-546l8m5jl8jlf6dqmmuje7gu6bs8a0ie.apps.googleusercontent.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
